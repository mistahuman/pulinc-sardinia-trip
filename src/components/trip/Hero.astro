---
import Countdown from '@components/trip/Countdown.svelte';
import Logo from '@components/generic/Logo.astro';
import { TRIP_RANGE } from '@lib/trip';

interface Props {
  start: string;
}

const { start } = Astro.props;
---

<section class="px-4 pt-10 pb-14 text-center xl:px-8 xl:pt-16">
  <div class="container mx-auto max-w-3xl">
    <Logo class="mx-auto h-40 w-auto sm:h-52" />

    <h1 class="mt-6 font-display leading-[0.86] text-surface-950 dark:text-surface-50">
      <span class="block text-[clamp(3.5rem,17vw,9rem)] tracking-[0.05em]">PULINC</span>
      <span
        class="block text-[clamp(1.5rem,6.5vw,3rem)] tracking-[0.02em] text-primary-700 dark:text-primary-300"
      >
        in Sardegna
      </span>
    </h1>

    <p class="mt-4 font-mono-trip text-xs uppercase tracking-[0.22em] opacity-60">
      {TRIP_RANGE}
    </p>

    <div class="mt-12">
      <Countdown target={start} client:load />
    </div>
  </div>
</section>
