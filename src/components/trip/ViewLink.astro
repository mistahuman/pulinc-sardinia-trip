---
import { ArrowRight } from 'lucide-svelte';

interface Props {
  href: string;
  label: string;
  /** Any lucide-svelte icon. */
  icon: typeof ArrowRight;
}

const { href, label, icon: Icon } = Astro.props;
---

<a
  href={href}
  class="group card preset-filled-surface-100-900 flex items-center gap-3 border border-surface-300-700 px-5 py-4 no-underline transition-colors hover:border-primary-500"
>
  <Icon size={20} class="shrink-0 text-primary-700 dark:text-primary-300" />
  <span class="font-display text-2xl tracking-[0.04em] text-surface-950 dark:text-surface-50">
    {label}
  </span>
  <ArrowRight
    size={16}
    class="ml-auto shrink-0 opacity-40 transition-transform group-hover:translate-x-1"
  />
</a>
