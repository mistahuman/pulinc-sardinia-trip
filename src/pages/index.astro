---
import { CalendarDays, Pin, Route } from 'lucide-svelte';
import Layout from '@layouts/Layout.astro';
import Hero from '@components/trip/Hero.astro';
import ViewLink from '@components/trip/ViewLink.astro';
import { TRIP_START } from '@lib/trip';

const base = import.meta.env.BASE_URL;

const views = [
  { href: `${base}itinerario`, label: 'Itinerario', icon: Route },
  { href: `${base}calendario`, label: 'Calendario', icon: CalendarDays },
  { href: `${base}bacheca`, label: 'Bacheca', icon: Pin },
];
---

<Layout>
  <Hero start={TRIP_START} />

  <section class="px-4 pb-20 xl:px-8">
    <div class="container mx-auto grid max-w-3xl gap-3 sm:grid-cols-3">
      {views.map((view) => <ViewLink {...view} />)}
    </div>
  </section>
</Layout>
