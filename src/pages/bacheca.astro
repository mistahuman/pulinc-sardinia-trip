---
import { getCollection } from 'astro:content';
import { MapPin, Square, SquareCheckBig, SquareX } from 'lucide-svelte';
import Layout from '@layouts/Layout.astro';
import Section from '@components/generic/Section.astro';
import Pitch from '@components/trip/Pitch.astro';
import { CREST_SIZE, CRESTS, crestUrl } from '@lib/crests';
import { spotifyEmbedUrl } from '@lib/spotify';
import { loadTeam } from '@lib/team';

const base = import.meta.env.BASE_URL;

// Icon and colour already carry the outcome — a lost challenge is red and
// crossed out, a won one green and ticked. No text label repeating it.
const STATUS_META = {
  open: {
    icon: Square,
    card: 'preset-filled-surface-100-900 border-surface-300-700',
    iconColor: 'text-surface-500',
  },
  won: {
    icon: SquareCheckBig,
    card: 'border-success-500/40 bg-success-500/10',
    iconColor: 'text-success-700 dark:text-success-300',
  },
  lost: {
    icon: SquareX,
    card: 'border-error-500/40 bg-error-500/10',
    iconColor: 'text-error-700 dark:text-error-300',
  },
} as const;

// Challenges still in play go on top: they're the only ones left to act on.
const STATUS_ORDER = { open: 0, won: 1, lost: 2 };

// Updated by hand, by changing `status` in the file under src/content/challenges.
const challenges = (await getCollection('challenges')).sort(
  (a, b) => STATUS_ORDER[a.data.status] - STATUS_ORDER[b.data.status],
);
const wonCount = challenges.filter((challenge) => challenge.data.status === 'won').length;

const SPOTS_LIST_URL = 'https://maps.app.goo.gl/vuQ6qZCC4jfhJCPp6?g_st=ac';

// Paste the share link straight out of Spotify; the embed URL is derived.
const PLAYLIST_URL = 'https://open.spotify.com/playlist/3vcAqoGdOcI874WReVtEim?si=f6be104d10e54638';
const playlistEmbed = spotifyEmbedUrl(PLAYLIST_URL);

const { rows, bench, formation } = await loadTeam();
---

<Layout title="Bacheca · PULINC" description="La bacheca dei Pulinc.">
  <section class="px-4 py-10 xl:px-8">
    <div class="container mx-auto max-w-4xl space-y-12">
      <Section title="Sfide" note={`${wonCount} / ${challenges.length}`}>
        <ul class="m-0 list-none space-y-2 p-0">
          {
            challenges.map((challenge) => {
              const meta = STATUS_META[challenge.data.status];
              const Icon = meta.icon;
              return (
                <li class:list={['card flex items-start gap-3 border p-3.5', meta.card]}>
                  <Icon size={18} class:list={['mt-0.5 shrink-0', meta.iconColor]} />
                  <span class="min-w-0 flex-1 text-pretty">{challenge.data.text}</span>
                </li>
              );
            })
          }
        </ul>
      </Section>

      <Section title="Squadra" note={formation}>
        <Pitch rows={rows} bench={bench} />
      </Section>

      <Section title="Playlist">
        {
          playlistEmbed ? (
            <iframe
              src={playlistEmbed}
              title="Playlist PULINC su Spotify"
              width="100%"
              height="420"
              loading="lazy"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              class="block w-full rounded-base border-0"
            />
          ) : (
            <p class="m-0 rounded-base border border-dashed border-surface-500/30 px-3.5 py-3 font-mono-trip text-xs opacity-60">
              Playlist da collegare
            </p>
          )
        }
      </Section>

      <Section title="Google Maps">
        {
          SPOTS_LIST_URL ? (
            <a
              class="card preset-filled-surface-100-900 flex items-center gap-3 border border-surface-300-700 p-3.5 no-underline transition-colors hover:border-primary-500/55"
              href={SPOTS_LIST_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-base bg-primary-500/14 text-primary-700 dark:text-primary-300">
                <MapPin size={20} />
              </span>
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="font-mono-trip text-[0.62rem] uppercase leading-none tracking-[0.16em] text-primary-700 dark:text-primary-300">
                  Lista condivisa
                </span>
                <span class="font-semibold leading-snug">PULINC Sardinia Trip</span>
              </span>
            </a>
          ) : (
            <p class="m-0 rounded-base border border-dashed border-surface-500/30 px-3.5 py-3 font-mono-trip text-xs opacity-60">
              Lista da collegare
            </p>
          )
        }
      </Section>

      <Section title="Logo">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            CRESTS.map((crest) => (
              <figure class="card preset-filled-surface-100-900 m-0 flex flex-col gap-4 border border-surface-300-700 p-5">
                <div class="flex min-h-56 items-center justify-center sm:min-h-72">
                  <img
                    src={crestUrl(base, crest.slug)}
                    width={CREST_SIZE.width}
                    height={CREST_SIZE.height}
                    alt={`Pulinc — Logo v${crest.version}`}
                    loading="lazy"
                    decoding="async"
                    class="h-52 w-auto object-contain sm:h-64"
                  />
                </div>
                <figcaption class="border-t border-surface-500/20 pt-3">
                  <span class="font-mono-trip text-[0.68rem] tracking-[0.14em] tabular-nums opacity-60">
                    v{crest.version}
                  </span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </Section>
    </div>
  </section>
</Layout>
