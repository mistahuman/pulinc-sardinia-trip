---
import Layout from '@layouts/Layout.astro';
import Polaroid from '@components/trip/Polaroid.astro';
import { loadSnapshots, photoUrl } from '@lib/snapshots';
import { TRIP_RANGE } from '@lib/trip';

const base = import.meta.env.BASE_URL;
const photos = await loadSnapshots();
---

<Layout title="Galleria · PULINC Sardinia Trip" description={`Le foto del viaggio, ${TRIP_RANGE}.`}>
  <section class="px-4 py-8 xl:px-8">
    <div class="container mx-auto max-w-4xl">
      <header class="mb-10 flex items-baseline gap-3">
        <h1
          class="font-mono-trip text-xs uppercase tracking-[0.22em] whitespace-nowrap text-surface-950 dark:text-surface-50"
        >
          Galleria
        </h1>
        <span class="font-mono-trip text-[0.68rem] tabular-nums opacity-55"
          >{photos.length} foto</span
        >
        <span class="h-px flex-1 bg-surface-500/25"></span>
      </header>

      {
        photos.length > 0 ? (
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5">
            {photos.map((photo) => (
              <Polaroid src={photoUrl(base, photo.src)} alt={photo.alt || photo.caption || ''} />
            ))}
          </div>
        ) : (
          <p class="m-0 rounded-base border border-dashed border-surface-500/30 px-3.5 py-3 font-mono-trip text-xs opacity-60">
            Nessuna foto ancora
          </p>
        )
      }
    </div>
  </section>
</Layout>
