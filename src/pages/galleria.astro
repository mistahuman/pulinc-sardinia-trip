---
import Layout from '@layouts/Layout.astro';
import Polaroid from '@components/trip/Polaroid.astro';
import { dayParts } from '@lib/eventMeta';
import { loadGallery, photoUrl, tilt } from '@lib/gallery';
import { TRIP_RANGE } from '@lib/trip';

const base = import.meta.env.BASE_URL;
const days = await loadGallery();
const total = days.reduce((sum, day) => sum + day.filled, 0);
---

<Layout title="Galleria · PULINC Sardinia Trip" description={`Le foto del viaggio, ${TRIP_RANGE}.`}>
  <section class="px-4 py-8 xl:px-8">
    <div class="container mx-auto max-w-4xl">
      <header class="mb-10 flex items-baseline gap-3">
        <h1
          class="font-mono-trip text-xs uppercase tracking-[0.22em] whitespace-nowrap text-surface-950 dark:text-surface-50"
        >
          Galleria
        </h1>
        <span class="font-mono-trip text-[0.68rem] tabular-nums opacity-55">{total} foto</span>
        <span class="h-px flex-1 bg-surface-500/25"></span>
      </header>

      {
        /* No rail here, unlike the itinerary: this is an album, not a plan. The
          day is a caption over a handful of prints someone dropped on a table. */
      }
      <ol class="m-0 list-none space-y-12 p-0">
        {
          days.map((day, dayIndex) => {
            const parts = dayParts(day.date);

            return (
              <li>
                <h2 class="mb-4 flex items-baseline gap-2.5">
                  <span class="font-display text-3xl leading-none text-surface-950 dark:text-surface-50">
                    {parts.num}
                  </span>
                  <span class="font-mono-trip text-[0.68rem] uppercase tracking-[0.2em] text-primary-700 dark:text-primary-300">
                    {parts.weekdayFull} {parts.month}
                  </span>
                </h2>

                <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5">
                  {day.slots.map((slot, slotIndex) => (
                    <Polaroid
                      src={slot ? photoUrl(base, slot.src) : undefined}
                      caption={slot?.caption}
                      alt={slot?.alt || slot?.caption || `${parts.num} ${parts.month}`}
                      tilt={tilt(dayIndex, slotIndex)}
                    />
                  ))}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</Layout>
